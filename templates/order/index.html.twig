{% extends 'base.html.twig' %}

{% block title %}Orders{% endblock %}

{% block body %}
{% block header_search %}{% endblock %}

<main class="ord-page">
  <div class="ord-page__inner">
    <header class="ord-toolbar ord-toolbar--actions-only">
      <h1 class="pp-sr-only">Orders</h1>
      <a href="{{ path('app_order_new') }}" class="pp-create-btn">
        <span aria-hidden="true">+</span> Add order
      </a>
    </header>

    <div class="ord-filters">
      <form method="get" class="ord-filters__form" aria-label="Search and filter orders">
        <input type="hidden" name="sort" value="date">
        <div class="pp-field ord-search-field">
          <label for="ord-search">Search</label>
          <input type="search" id="ord-search" name="search" value="{{ search }}" class="ord-search" placeholder="Order name or customer…" autocomplete="off">
        </div>
        <div class="pp-field ord-select-wrap">
          <label for="ord-filter-status">Status</label>
          <select id="ord-filter-status" name="status" class="pp-select">
            <option value="" {{ statusFilter is empty ? 'selected' : '' }}>All statuses</option>
            <option value="Pending" {{ statusFilter == 'Pending' ? 'selected' : '' }}>Pending</option>
            <option value="Completed" {{ statusFilter == 'Completed' ? 'selected' : '' }}>Completed</option>
          </select>
        </div>
        <div class="pp-field ord-select-wrap">
          <label for="ord-filter-date">Date order</label>
          <select id="ord-filter-date" name="dir" class="pp-select" aria-describedby="ord-date-hint">
            <option value="desc" {{ dir == 'desc' ? 'selected' : '' }}>Newest first</option>
            <option value="asc" {{ dir == 'asc' ? 'selected' : '' }}>Oldest first</option>
          </select>
          <span id="ord-date-hint" class="pp-sr-only">Applies to order date column</span>
        </div>
        <div class="ord-filter-actions">
          <button type="submit" class="pp-btn-filter">Apply</button>
          <a href="{{ path('app_order_index') }}" class="pp-btn-clear">Reset</a>
        </div>
      </form>
    </div>

    <section class="ord-table-panel" aria-labelledby="ord-table-heading">
      <div class="ord-table-panel__head">
        <h2 id="ord-table-heading">All orders</h2>
      </div>
      <div class="ord-datatable-scroll">
        <table id="ordersIndexTable" class="ord-table">
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Name</th>
              <th scope="col">Customer</th>
              <th scope="col">Category</th>
              <th scope="col">Date</th>
              <th scope="col">Status</th>
              <th scope="col">Total</th>
              <th scope="col">Payment</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody id="ordersTableBody">
            {% include 'order/_rows.html.twig' with { orders: orders } %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const bodyEl = document.getElementById('ordersTableBody');
    const query = window.location.search || '';
    const rowsUrl = "{{ path('app_order_rows') }}" + query;
    const streamUrl = "{{ path('app_order_stream') }}" + query;
    let previousSignature = '';
    let firstSyncDone = false;
    let stream = null;
    let reconnectTimer = null;
    let pollBusy = false;

    function showLiveMessage(message) {
      let toast = document.getElementById('order-live-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'order-live-toast';
        toast.style.position = 'fixed';
        toast.style.right = '16px';
        toast.style.bottom = '16px';
        toast.style.padding = '10px 14px';
        toast.style.borderRadius = '8px';
        toast.style.background = '#1f2937';
        toast.style.color = '#f9fafb';
        toast.style.fontSize = '13px';
        toast.style.zIndex = '9999';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.style.opacity = '1';
      setTimeout(() => {
        toast.style.opacity = '0';
      }, 2500);
    }

    async function refreshRowsSilently() {
      if (pollBusy || !bodyEl) {
        return;
      }
      pollBusy = true;
      try {
        const response = await fetch(rowsUrl, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          cache: 'no-store',
        });
        if (!response.ok) {
          return;
        }
        const payload = await response.json();
        if (!payload || typeof payload.rowsHtml !== 'string') {
          return;
        }
        if (typeof payload.rowsSignature === 'string' && payload.rowsSignature !== previousSignature) {
          bodyEl.innerHTML = payload.rowsHtml;
          previousSignature = payload.rowsSignature;
          if (firstSyncDone) {
            showLiveMessage('New/updated order received');
          }
        }
        firstSyncDone = true;
      } catch (error) {
        // fail silently and retry on the next interval
      } finally {
        pollBusy = false;
      }
    }

    window.setInterval(refreshRowsSilently, 20000);
    refreshRowsSilently();

    function connectStream() {
      if (stream) {
        stream.close();
      }
      stream = new EventSource(streamUrl);

      stream.addEventListener('orders', event => {
        try {
          const payload = JSON.parse(event.data);
          if (!payload || typeof payload.rowsHtml !== 'string') {
            return;
          }
          if (typeof payload.rowsSignature === 'string' && payload.rowsSignature !== previousSignature) {
            bodyEl.innerHTML = payload.rowsHtml;
            previousSignature = payload.rowsSignature;
            if (firstSyncDone) {
              showLiveMessage('New/updated order received');
            }
          }
          firstSyncDone = true;
        } catch (error) {
          // Ignore malformed events and wait for the next one.
        }
      });

      stream.onerror = () => {
        stream.close();
        if (reconnectTimer) {
          clearTimeout(reconnectTimer);
        }
        reconnectTimer = setTimeout(connectStream, 1500);
      };
    }

    if (window.EventSource) {
      connectStream();
    }

    if (window.DataTable) {
      new DataTable('#ordersIndexTable', {
        responsive: true,
        searching: false,
        paging: false,
        lengthChange: false,
        info: false,
        order: [],
        language: {
          emptyTable: 'No orders match your filters.',
        },
      });
    }
  });
</script>
{% endblock %}
