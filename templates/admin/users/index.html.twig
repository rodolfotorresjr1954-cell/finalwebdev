{% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
<main class="um-page">
  <div class="um-page__inner">
    <header class="um-toolbar">
      <h1 class="pp-sr-only">User management</h1>
      <a href="{{ path('admin_user_new') }}" class="pp-create-btn pp-create-btn--violet">
        <span aria-hidden="true">+</span> Create user
      </a>
    </header>

    <div class="um-filters">
      <form method="get" class="um-filters__form" aria-label="Search and filter users">
        <div class="pp-field um-search-field">
          <label for="um-search">Search</label>
          <input type="search" id="um-search" name="search" value="{{ search }}" class="um-search" placeholder="Username or email…" autocomplete="off">
        </div>
        <div class="pp-field">
          <label for="um-role">Role</label>
          <select id="um-role" name="role" class="pp-select">
            <option value="" {{ roleFilter is empty ? 'selected' : '' }}>All roles</option>
            <option value="ROLE_ADMIN" {{ roleFilter == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
            <option value="ROLE_STAFF" {{ roleFilter == 'ROLE_STAFF' ? 'selected' : '' }}>Staff</option>
            <option value="ROLE_USER" {{ roleFilter == 'ROLE_USER' ? 'selected' : '' }}>User</option>
          </select>
        </div>
        <div class="pp-field">
          <label for="um-status">Status</label>
          <select id="um-status" name="status" class="pp-select">
            <option value="" {{ statusFilter is empty ? 'selected' : '' }}>All statuses</option>
            <option value="active" {{ statusFilter == 'active' ? 'selected' : '' }}>Active</option>
            <option value="inactive" {{ statusFilter == 'inactive' ? 'selected' : '' }}>Inactive</option>
          </select>
        </div>
        <div class="um-filter-actions">
          <button type="submit" class="pp-btn-filter">Apply</button>
          <a href="{{ path('admin_user_index') }}" class="pp-btn-clear">Reset</a>
        </div>
      </form>
    </div>

    <section class="um-table-panel" aria-labelledby="um-table-heading">
      <div class="um-table-panel__head">
        <h2 id="um-table-heading">Directory</h2>
      </div>
      <div class="um-table-scroll">
        <table class="um-table">
          <thead>
            <tr>
              <th scope="col">Username</th>
              <th scope="col">Email</th>
              <th scope="col">Role</th>
              <th scope="col">Status</th>
              <th scope="col">Created</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody id="userManagementBody">
            {% include 'admin/users/_rows.html.twig' %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const bodyEl = document.getElementById('userManagementBody');
    const query = window.location.search || '';
    const rowsUrl = "{{ path('admin_user_rows') }}" + query;
    const streamUrl = "{{ path('admin_user_stream') }}" + query;

    let previousSignature = '';
    let firstSyncDone = false;
    let stream = null;
    let reconnectTimer = null;
    let pollBusy = false;

    function showLiveMessage(message) {
      let toast = document.getElementById('um-live-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'um-live-toast';
        toast.style.position = 'fixed';
        toast.style.right = '16px';
        toast.style.bottom = '16px';
        toast.style.padding = '10px 14px';
        toast.style.borderRadius = '8px';
        toast.style.background = '#1f2937';
        toast.style.color = '#f9fafb';
        toast.style.fontSize = '13px';
        toast.style.zIndex = '9999';
        toast.style.transition = 'opacity 0.3s ease';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.style.opacity = '1';
      setTimeout(function () { toast.style.opacity = '0'; }, 2500);
    }

    function applyPayload(payload) {
      if (!payload || typeof payload.rowsSignature !== 'string') {
        return;
      }
      if (payload.rowsSignature === previousSignature) {
        return;
      }
      previousSignature = payload.rowsSignature;

      if (bodyEl && typeof payload.rowsHtml === 'string') {
        bodyEl.innerHTML = payload.rowsHtml;
      }
      if (firstSyncDone) {
        showLiveMessage('User list updated — new registration');
      }
      firstSyncDone = true;
    }

    async function refreshSilently() {
      if (pollBusy) {
        return;
      }
      pollBusy = true;
      try {
        const response = await fetch(rowsUrl, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          cache: 'no-store',
        });
        if (!response.ok) {
          return;
        }
        applyPayload(await response.json());
      } catch (error) {
        // retry on next interval
      } finally {
        pollBusy = false;
      }
    }

    window.setInterval(refreshSilently, 20000);
    refreshSilently();

    function connectStream() {
      if (!window.EventSource) {
        return;
      }
      if (stream) {
        stream.close();
      }
      stream = new EventSource(streamUrl);

      stream.addEventListener('users', function (event) {
        try {
          applyPayload(JSON.parse(event.data));
        } catch (error) {
          // wait for next event
        }
      });

      stream.onerror = function () {
        stream.close();
        if (reconnectTimer) {
          clearTimeout(reconnectTimer);
        }
        reconnectTimer = setTimeout(connectStream, 1500);
      };
    }

    connectStream();
  });
</script>
{% endblock %}
