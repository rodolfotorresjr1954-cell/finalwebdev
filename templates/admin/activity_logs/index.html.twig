{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block body %}
<main class="al-page">
    <div class="al-page__inner">
        <h1 class="pp-sr-only">Activity logs</h1>

        <section class="al-filters" aria-label="Filter activity logs">
            <form method="get" class="al-filters__form">
                <div class="pp-field">
                    <label for="al-filter-user">User</label>
                    <select id="al-filter-user" name="user" class="pp-select">
                        <option value="">All users</option>
                        {% for u in users %}
                            <option value="{{ u.id }}" {{ filters.user == u.id ? 'selected' : '' }}>{{ u.username }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="pp-field">
                    <label for="al-filter-action">Action</label>
                    <select id="al-filter-action" name="action" class="pp-select">
                        <option value="">All actions</option>
                        {% for act in actions %}
                            <option value="{{ act }}" {{ filters.action == act ? 'selected' : '' }}>{{ act }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="pp-field al-date-field">
                    <label for="al-filter-start">From</label>
                    <input type="date" id="al-filter-start" name="start_date" value="{{ filters.start_date }}" class="al-date" autocomplete="off">
                </div>
                <div class="pp-field al-date-field">
                    <label for="al-filter-end">To</label>
                    <input type="date" id="al-filter-end" name="end_date" value="{{ filters.end_date }}" class="al-date" autocomplete="off">
                </div>
                <div class="al-filter-actions">
                    <button type="submit" class="pp-btn-filter">Apply</button>
                    <a href="{{ path('admin_activity_log_index') }}" class="pp-btn-clear">Reset</a>
                </div>
            </form>
        </section>

        <section class="al-table-panel" aria-label="Activity log entries">
            <header class="al-table-panel__head">
                <h2>Audit trail</h2>
            </header>
            <div class="al-table-scroll">
                <table class="al-table">
                    <thead>
                        <tr>
                            <th scope="col">Timestamp</th>
                            <th scope="col">User</th>
                            <th scope="col">Role</th>
                            <th scope="col">Action</th>
                            <th scope="col">Entity</th>
                            <th scope="col">Description</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="activityLogsBody">
                        {% include 'admin/activity_logs/_rows.html.twig' %}
                    </tbody>
                </table>
            </div>

            {% if totalPages > 1 %}
                <nav class="al-pagination" aria-label="Pagination">
                    <ul class="dash-page-nav">
                        {% if page > 1 %}
                            <li><a href="{{ path('admin_activity_log_index', {page: page - 1}|merge(filters)) }}">Prev</a></li>
                        {% else %}
                            <li><span class="opacity-50" aria-disabled="true">Prev</span></li>
                        {% endif %}
                        {% for i in 1..totalPages %}
                            {% if i == page %}
                                <li><span class="dash-page-nav__current" aria-current="page">{{ i }}</span></li>
                            {% else %}
                                <li><a href="{{ path('admin_activity_log_index', {page: i}|merge(filters)) }}">{{ i }}</a></li>
                            {% endif %}
                        {% endfor %}
                        {% if page < totalPages %}
                            <li><a href="{{ path('admin_activity_log_index', {page: page + 1}|merge(filters)) }}">Next</a></li>
                        {% else %}
                            <li><span class="opacity-50" aria-disabled="true">Next</span></li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}

            <footer class="al-footer">
                <span id="activityLogsFooter">Showing {{ logs|length }} of {{ totalLogs }} entries</span>
                {% if totalPages > 1 %}
                    <span>Page {{ page }} / {{ totalPages }}</span>
                {% endif %}
            </footer>
        </section>
    </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const bodyEl = document.getElementById('activityLogsBody');
    const footerEl = document.getElementById('activityLogsFooter');
    const query = window.location.search || '';
    const rowsUrl = "{{ path('admin_activity_log_rows') }}" + query;
    const streamUrl = "{{ path('admin_activity_log_stream') }}" + query;

    let previousSignature = '';
    let firstSyncDone = false;
    let stream = null;
    let reconnectTimer = null;
    let pollBusy = false;

    function showLiveMessage(message) {
      let toast = document.getElementById('al-live-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'al-live-toast';
        toast.style.position = 'fixed';
        toast.style.right = '16px';
        toast.style.bottom = '16px';
        toast.style.padding = '10px 14px';
        toast.style.borderRadius = '8px';
        toast.style.background = '#1f2937';
        toast.style.color = '#f9fafb';
        toast.style.fontSize = '13px';
        toast.style.zIndex = '9999';
        toast.style.transition = 'opacity 0.3s ease';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.style.opacity = '1';
      setTimeout(function () { toast.style.opacity = '0'; }, 2500);
    }

    function applyPayload(payload) {
      if (!payload || typeof payload.rowsSignature !== 'string') {
        return;
      }
      if (payload.rowsSignature === previousSignature) {
        return;
      }
      previousSignature = payload.rowsSignature;

      if (bodyEl && typeof payload.rowsHtml === 'string') {
        bodyEl.innerHTML = payload.rowsHtml;
      }
      if (footerEl && typeof payload.footerText === 'string') {
        footerEl.textContent = payload.footerText;
      }
      if (firstSyncDone) {
        showLiveMessage('Activity log updated');
      }
      firstSyncDone = true;
    }

    async function refreshSilently() {
      if (pollBusy) {
        return;
      }
      pollBusy = true;
      try {
        const response = await fetch(rowsUrl, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          cache: 'no-store',
        });
        if (!response.ok) {
          return;
        }
        applyPayload(await response.json());
      } catch (error) {
        // retry on next interval
      } finally {
        pollBusy = false;
      }
    }

    window.setInterval(refreshSilently, 20000);
    refreshSilently();

    function connectStream() {
      if (!window.EventSource) {
        return;
      }
      if (stream) {
        stream.close();
      }
      stream = new EventSource(streamUrl);

      stream.addEventListener('activity_logs', function (event) {
        try {
          applyPayload(JSON.parse(event.data));
        } catch (error) {
          // wait for next event
        }
      });

      stream.onerror = function () {
        stream.close();
        if (reconnectTimer) {
          clearTimeout(reconnectTimer);
        }
        reconnectTimer = setTimeout(connectStream, 1500);
      };
    }

    connectStream();
  });
</script>
{% endblock %}
